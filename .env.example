# Variables publiques injectées au build Flutter.
# Ne jamais mettre ici une clé service_role ou une clé API Brevo.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_PUBLISHABLE_KEY=votre_cle_publishable

# Exemple :
# flutter run --dart-define=SUPABASE_URL="$SUPABASE_URL" \
#   --dart-define=SUPABASE_PUBLISHABLE_KEY="$SUPABASE_PUBLISHABLE_KEY"
